<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- A minimal Quake 3 style game for the headless Lua tests, so they do
     not depend on downloaded gamepacks or game data. -->
<game
  type="q3"
  index="1"
  name="LuaDiant test game"
  basegame="base"
  basegamename="LuaDiant test game"
  unknowngamename="Custom LuaDiant test game modification"
  default_scale="0.5"
  archivetypes="pk3"
  texturetypes="tga jpg png"
  modeltypes="md3 ase obj"
  maptypes="mapq3"
  shaders="quake3"
  shaderpath="scripts/"
  entityclass="quake3"
  entityclasstype="def"
  entities="quake3"
  brushtypes="quake3"
  patchtypes="quake3"
  enginepath_linux="/nonexistent/"
  enginepath_win32="C:/nonexistent/"
  enginepath_macos="/nonexistent/"
  engine_linux="true"
  engine_win32="true.exe"
  engine_macos="true"
/>
